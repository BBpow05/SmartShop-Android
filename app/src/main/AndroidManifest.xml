<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyền truy cập Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="SmartShop"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartShop">

        <!-- Đăng nhập -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Đăng ký -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Thanh toán -->
        <activity
            android:name=".ui.cart.CheckoutActivity"
            android:exported="false" />

        <!-- Giỏ hàng -->
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false" />

        <!-- Sản phẩm yêu thích -->
        <activity
            android:name=".ui.favorite.FavoriteActivity"
            android:exported="false" />

        <!-- Tài khoản -->
        <activity
            android:name=".ui.account.AccountActivity"
            android:exported="false" />

        <!-- Danh sách và tìm kiếm sản phẩm -->
        <activity
            android:name=".ui.product.ProductCatalogActivity"
            android:exported="false" />

        <!-- Chi tiết sản phẩm -->
        <activity
            android:name=".ui.product.ProductDetailActivity"
            android:exported="false" />

        <!-- Màn hình chính -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
