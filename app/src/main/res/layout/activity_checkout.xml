<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin thanh toán"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#168044"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Họ và tên người nhận *" />

        <EditText
            android:id="@+id/edtFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập họ và tên"
            android:inputType="textPersonName"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số điện thoại *"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập số điện thoại"
            android:inputType="phone"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Địa chỉ nhà *"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/edtAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số nhà, đường, phường/xã, tỉnh/thành"
            android:inputType="textPostalAddress"
            android:minLines="2"
            android:gravity="top"
            android:padding="12dp" />

        <TextView
            android:id="@+id/txtCheckoutTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tổng thanh toán: 0 đ"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#168044"
            android:paddingTop="24dp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnConfirmPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xác nhận thanh toán"
            android:backgroundTint="#168044" />

        <Button
            android:id="@+id/btnCancelPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hủy" />

    </LinearLayout>

</ScrollView>
